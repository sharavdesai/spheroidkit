# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Build artifacts (produced by `python -m build`)
build/
dist/
*.whl
*.tar.gz

# Virtual environments
venv/
.venv/
env/

# Node (only used for manuscript generation, not the package)
node_modules/
package-lock.json

# Generated figures / scratch outputs
*.png
fig_*.png
examples/output/

# ...but the bundled example images and documentation figures ARE tracked.
# Negations must come after the broad pattern above, and the parent directory
# must not itself be ignored, or git will never look inside it.
!examples/data/*.png
!docs/img/*.png

# OS / editor cruft
.DS_Store
.vscode/
.idea/
